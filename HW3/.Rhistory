for (cut in cutoffs) {
predicted_bin = ifelse(predicted >= cut, 1, 0)
df <- data.frame(Actual = mydata$DRINKING_D, Predicted = predicted_class)
# sensitivity = TP / (TP + FN), specificity = TN / (TN + FP)
df$TP <- ifelse(df$Actual&df$Predicted==1,1,0);
FN <- ifelse(df$Actual==1&df$Predicted==0,1,0);
TN <- ifelse(df$Actual==0&df$Predicted==0,1,0);
FP <- ifelse(df$Actual==0&df$Predicted==1,1,0)
sen$sensitivity     <- sum(df$TP==1) / (sum(df$TP==1) + sum(df$FN==1))
sen$specificity     <- sum(df$FN==1) / (sum(df$TN==1) + sum(df$FP==1))
sen$misclass        <- ( sum(df$FP==1) + sum(df$FN==1)) / count(df)
}
