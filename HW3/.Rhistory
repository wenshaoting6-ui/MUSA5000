# Pearson correlations (part d)
library(Hmisc)
rcorr(as.matrix(mydata[, c("FATAL_OR_M","OVERTURNED","CELL_PHONE",
"SPEEDING","AGGRESSIVE","DRIVER1617","DRIVER65PLUS",
"PCTBACHMOR","MEDHHINC")]))
library(stargazer)
library(Hmisc)
# Build correlation matrix
vars <- mydata[, c("FATAL_OR_M","OVERTURNED","CELL_PHONE","SPEEDING",
"AGGRESSIVE","DRIVER1617","DRIVER65PLUS","PCTBACHMOR","MEDHHINC")]
corr_matrix <- rcorr(as.matrix(vars))
r <- corr_matrix$r
p <- corr_matrix$P
# ── Option 1: Print to console ────────────────────────────────────────────
stargazer(r,
title = "Pearson Correlation Matrix",
type = "text",
digits = 2)
# ── Option 1: Print to console ────────────────────────────────────────────
stargazer(r,
title = "Pearson Correlation Matrix",
type = "html",
digits = 2,
out = "correlation_table.html")
#logit model
mylogit1 <- glm(DRINKING_D ~ FATAL_OR_M + OVERTURNED + CELL_PHONE + SPEEDING +
AGGRESSIVE + DRIVER1617 + DRIVER65PLUS + PCTBACHMOR + MEDHHINC,
data = mydata, family = binomial)
summary(mylogit1)
# Odds ratios and 95% CI merged matrix
exp(cbind(OR = coef(mylogit1), confint(mylogit1)))
# ── 3a.iii: Sensitivity, specificity, misclassification rate ─────────────
library(ResourceSelection)  # install if needed
install.packages("ResourceSelection")
# ── 3a.iii: Sensitivity, specificity, misclassification rate ─────────────
library(ResourceSelection)  # install if needed
predicted <- predict(mylogit1, type = "response")
cutoffs <- c(0.02, 0.03, 0.05, 0.07, 0.08, 0.09, 0.10, 0.15, 0.20, 0.50)
for (cut in cutoffs) {
predicted_class <- ifelse(predicted >= cut, 1, 0)
cm <- table(Actual = mydata$DRINKING_D, Predicted = predicted_class)
# sensitivity = TP / (TP + FN), specificity = TN / (TN + FP)
TP <- cm[2,2]; FN <- cm[2,1]; TN <- cm[1,1]; FP <- cm[1,2]
sensitivity     <- TP / (TP + FN)
specificity     <- TN / (TN + FP)
misclass        <- (FP + FN) / sum(cm)
cat(sprintf("Cut-off: %.2f | Sensitivity: %.4f | Specificity: %.4f | Misclassification: %.4f\n",
cut, sensitivity, specificity, misclass))
}
# ── 3a.iv & v: ROC curve and AUC ─────────────────────────────────────────
install.packages("pROC")  # if needed
library(pROC)
roc1 <- roc(mydata$DRINKING_D, predicted)
# Plot ROC curve
plot(roc1,
col = "blue",
lwd = 2,
main = "ROC Curve – Full Model",
print.thres = "best",       # marks optimal cut-off
print.auc = TRUE)           # prints AUC on plot
# Export ROC curve
jpeg("ROC_fullmodel.jpg", width = 800, height = 600, res = 120)
plot(roc1, col = "blue", lwd = 2, main = "ROC Curve – Full Model",
print.thres = "best", print.auc = TRUE)
dev.off()
# AUC
auc(roc1)
# ── 3b: Reduced model ─────────────────────────────────────────────────────
mylogit2 <- glm(DRINKING_D ~ FATAL_OR_M + OVERTURNED + CELL_PHONE + SPEEDING +
AGGRESSIVE + DRIVER1617 + DRIVER65PLUS,
data = mydata, family = binomial)
summary(mylogit2)
exp(cbind(OR = coef(mylogit2), confint(mylogit2)))
# ── 3c: AIC comparison ────────────────────────────────────────────────────
AIC(mylogit1, mylogit2)
output=summary(mylogit1)
output1=summary(mylogit1)
